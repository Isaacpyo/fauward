{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/session_start.ps1",
            "statusMessage": "Loading Fauward session context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/stop_snapshot.ps1",
            "statusMessage": "Capturing Fauward working tree snapshot",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

