# Backend
NODE_ENV=development
PORT=3001

# Database
# Use pooler for runtime (if needed), direct for migrations
DATABASE_URL=postgresql://postgres.zfvzaiffkpqdhskpnwic:YOUR_PASSWORD@aws-1-eu-central-2.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.zfvzaiffkpqdhskpnwic.supabase.co:5432/postgres?sslmode=require

# Redis
REDIS_URL=rediss://default:YOUR_TOKEN@welcomed-midge-93153.upstash.io:6379

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MFA
MFA_ISSUER=Fauward

# Tenant
PLATFORM_DOMAIN=fauward.com
RESERVED_DOMAINS=fauward.com,www.fauward.com,api.fauward.com,app.fauward.com

# Tenant-facing URLs (used in transactional emails — e.g. staff invite "Sign in" link)
# TENANT_DRIVER role lands on Fauward Go, everyone else on the tenant portal.
TENANT_PORTAL_URL=https://app.fauward.com
FAUWARD_GO_URL=https://fauward.com/go

# SendGrid transactional email
# API key needs the Mail Send scope. Rotate from sendgrid.com → Settings → API Keys.
SENDGRID_API_KEY=
# Default sender — must match a Verified Sender or an Authenticated Domain in SendGrid.
SENDGRID_FROM_EMAIL=support@fauward.com
SENDGRID_FROM_NAME=Fauward
# Map each notification key to its SendGrid dynamic-template ID (`d-…`).
# Required for any template you actually send; missing IDs cause the worker
# to mark the NotificationLog row as FAILED with a clear error.
SENDGRID_TEMPLATE_STAFF_INVITE=
SENDGRID_TEMPLATE_PASSWORD_RESET=
SENDGRID_TEMPLATE_BOOKING_CONFIRMED=
SENDGRID_TEMPLATE_SHIPMENT_PICKED_UP=
SENDGRID_TEMPLATE_OUT_FOR_DELIVERY=
SENDGRID_TEMPLATE_DELIVERED=
SENDGRID_TEMPLATE_FAILED_DELIVERY=
SENDGRID_TEMPLATE_SHIPMENT_EXCEPTION=
SENDGRID_TEMPLATE_INVOICE_SENT=
SENDGRID_TEMPLATE_INVOICE_OVERDUE=
SENDGRID_TEMPLATE_PAYMENT_RECEIVED=
SENDGRID_TEMPLATE_RETURN_APPROVED=
SENDGRID_TEMPLATE_RETURN_RECEIVED=
SENDGRID_TEMPLATE_RETURN_REFUNDED=
SENDGRID_TEMPLATE_TICKET_CREATED=
SENDGRID_TEMPLATE_TICKET_REPLY_FROM_STAFF=
SENDGRID_TEMPLATE_TICKET_REPLY_FROM_CUSTOMER=
SENDGRID_TEMPLATE_TICKET_RESOLVED=
SENDGRID_TEMPLATE_TRIAL_EXPIRING=
SENDGRID_TEMPLATE_TRIAL_EXPIRY=
SENDGRID_TEMPLATE_USAGE_WARNING_80=
SENDGRID_TEMPLATE_USAGE_LIMIT_REACHED=
SENDGRID_TEMPLATE_OPS_NEW_SHIPMENT=

# Vercel Domains API for tenant portal custom domains
VERCEL_API_TOKEN=
VERCEL_PORTAL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_BASE=https://api.vercel.com
VERCEL_EXPECTED_PORTAL_DOMAIN=app.fauward.com

# Status dashboard custom-domain checks
LOCAL_BACKEND_URL=http://localhost:3001
BACKEND_URL=
MONITORING_API_KEY=
CUSTOM_DOMAIN_PROBE_HOSTS=
STATUS_DASHBOARD_PROD_URL=
FAUWARD_GO_PROD_URL=

# Optional: enable only when running the Supabase CLI local stack.
# Default Fauward local development uses Docker Postgres on localhost:5432 instead.
SUPABASE_LOCAL_ENABLED=false
SUPABASE_LOCAL_URL=http://localhost:54321

# Platform control plane auth
PLATFORM_SESSION_SECRET=change_me_platform_session_secret_min_32_chars
PLATFORM_REFRESH_SECRET=change_me_platform_refresh_secret_min_32_chars
