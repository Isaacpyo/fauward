# /data/fauward-prod/env/backend.env on the VM (chmod 600). Copy the values from Railway:
# Railway → backend service → Variables → Raw Editor. Never commit the filled-in file.
# REDIS_URL, PORT, NODE_ENV, ROUTE_OPTIMIZER_URL and PYTHON_SERVICES_URL are set by docker-compose.yml.

# ── Required ──
DATABASE_URL=               # Prisma runtime URL (Supabase pooler) — copy from Railway as-is
DIRECT_URL=                 # Prisma migrations URL (Supabase session/direct, port 5432); also used by `prod-vm.sh backup`
SUPABASE_DB_URL=            # read by the app config; normally the same value as DATABASE_URL
SUPABASE_DIRECT_URL=        # normally the same value as DIRECT_URL
JWT_ACCESS_SECRET=          # ≥ 16 chars; keep Railway's value or every user is logged out
JWT_REFRESH_SECRET=
PLATFORM_SESSION_SECRET=    # production refuses to boot without these three
PLATFORM_REFRESH_SECRET=
PLATFORM_COOKIE_DOMAIN=.fauward.com

# ── Monitoring (status dashboard, Python observability) ──
MONITORING_API_KEY=         # generated by init; init copies it to python.env; set the same value in the status-dashboard Vercel project

# ── Email / SMS / payments ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@fauward.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=      # new signing secret after you point the Stripe webhook at api.fauward.com

# ── Supabase storage ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tenant portal custom domains (Vercel API) — required: the backend will not start without the first two ──
VERCEL_API_TOKEN=
VERCEL_PORTAL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── AI agent ──
DEEPSEEK_API_KEY=
AGENT_SERVICE_TOKEN=

# ── Console ──
# Field encryption (TOTP secrets etc.). Production refuses to boot without it. `prod-vm.sh init` generates
# both when they are empty. Losing the key makes the encrypted values unreadable: keep a copy of this file.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
CONSOLE_URL=https://admin.fauward.com
# FAUWARD_GO_URL=https://fauward.com/go   # the emailed sign-in link opens Fauward Go here; uncomment to change
CONSOLE_MFA_REQUIRED=true
PLATFORM_BASE_CURRENCY=GBP
TENANT_CLOSE_RETENTION_DAYS=90
DEV_HARDWARE_KEY_ASSERTION=   # only if production needs ROOT grants; unset = ROOT grants return 503

# ── Optional integrations (leave empty when unused) ──
LAUNCHDARKLY_API_TOKEN=
PAGERDUTY_WEBHOOK_SECRET=
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
COMPLYADVANTAGE_API_KEY=
COMPLYADVANTAGE_WEBHOOK_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_WEBHOOK_SECRET=
