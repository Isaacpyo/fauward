# /data/fauward-prod/env/python.env on the VM (chmod 600). Shared by python-api, python-worker, python-beat.
# REDIS_URL, BACKEND_URL and the queue/storage settings are set by docker-compose.yml.
DATABASE_URL=               # same Supabase database as the backend (SQLAlchemy URL, postgresql://...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MONITORING_API_KEY=         # same value as backend.env
PYTHON_OBS_API_KEY=
PYTHON_DEFAULT_EMAIL_FROM=no-reply@fauward.com
OSRM_BASE_URL=http://router.project-osrm.org
LOG_LEVEL=INFO
PROD_API_URL=https://api.fauward.com
PROD_FRONTEND_URL=https://www.fauward.com
PROD_TENANT_PORTAL_URL=https://app.fauward.com
PROD_SUPER_ADMIN_URL=https://admin.fauward.com
SENTRY_DSN=
