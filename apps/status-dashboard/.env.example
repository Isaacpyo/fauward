# Prod database/cache URLs — used only for TCP host:port checks (no credentials sent).
# Copy this file to .env and fill in the values from apps/backend/.env.

DATABASE_URL=postgresql://user:pass@host:port/db
REDIS_URL=rediss://default:pass@host:port

# Optional: backend URL for queue metrics + business health
BACKEND_URL=https://fauwardbackend-production.up.railway.app

# Vercel/serverless deployment checks prod only by default.
# Local Express dev checks local + prod by default.
STATUS_DASHBOARD_ACTIVE_ENVS=prod
STATUS_DASHBOARD_PROD_URL=https://admin.fauward.com/status
FAUWARD_GO_PROD_URL=https://app.fauward.com/go
CUSTOM_DOMAIN_PROBE_HOSTS=
STATUS_REQUEST_REFRESH_MS=15000

# Optional: protect the monitoring endpoints in production
MONITORING_API_KEY=

# Python Observability API (services/python-services, port 8000)
PYTHON_API_URL=http://localhost:8000
PYTHON_OBS_API_KEY=

# Alert channels
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
