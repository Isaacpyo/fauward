{
  "rewrites": [
    {
      "source": "/api/internal/:path*",
      "destination": "https://api.fauward.com/api/internal/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "console/*": false,
      "claude/*": false
    }
  }
}
