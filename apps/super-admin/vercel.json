{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.fauward.com/api/v1/:path*"
    },
    {
      "source": "/api/internal/:path*",
      "destination": "https://api.fauward.com/api/internal/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
