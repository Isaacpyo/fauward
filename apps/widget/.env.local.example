# Supabase - service role key is server-side only, never exposed to browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret for widget tokens - minimum 32 characters
WIDGET_TOKEN_SECRET=change-me-to-a-long-random-secret-string

# Vercel widget project + Edge Config
# Create the widget Vercel project and linked Edge Config store before setting these.
VERCEL_TOKEN=vercel-token-for-widget-domain-management
VERCEL_PROJECT_ID=prj_widget_project_id
EDGE_CONFIG_ID=ecfg_widget_edge_config_id
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_widget_edge_config_id?token=...

# Twilio - for phone OTP verification
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Stripe - public key used by the client-side payment form
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Firebase - public client config imported by the widget
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Not used by apps/widget today:
# - TWILIO_FROM (legacy; code reads TWILIO_FROM_NUMBER)
# - STRIPE_SECRET_KEY (add only when a server-side payment-intent route exists)
