  status           String   @default("ACTIVE")
  commissionConfig Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications  PartnerApplication[]
  registrations PartnerDealRegistration[]
  commissions   CommissionLedger[]
  payouts       CommissionPayout[]

  @@index([status])
  @@map("partners")
}

model PartnerApplication {
  id             String   @id @default(uuid())
  partnerId      String?
  applicantEmail String
  companyName    String
  type           String
  status         String   @default("PENDING")
  payload        Json?
  decidedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("partner_applications")
}

model PartnerDealRegistration {
  id          String   @id @default(uuid())
  partnerId   String
  leadEmail   String
  companyName String
  status      String   @default("REGISTERED")
  lockedUntil DateTime
  dealId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([leadEmail])
  @@index([partnerId, status])
  @@map("partner_deal_registrations")
}

model CommissionLedger {
  id        String   @id @default(uuid())
  partnerId String
  tenantId  String?
  dealId    String?
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("GBP")
  status    String   @default("EARNED")
  period    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, period])
  @@index([status])
  @@map("commission_ledger")
}

model CommissionPayout {
  id                String   @id @default(uuid())
  partnerId         String
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("GBP")
  status            String   @default("PENDING")
  approvedByFinance String?
  approvedByCfo     String?
  stripeTransferId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@map("commission_payouts")
}

model CommissionDispute {
  id         String   @id @default(uuid())
  partnerId  String
  payoutId   String?
  message    String
  status     String   @default("OPEN")
  resolvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([partnerId, status])
  @@map("commission_disputes")
}

model SsoProvider {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  providerType String
  entityId     String?
  ssoUrl       String?
  certificate  String?
  attributeMap Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("sso_providers")
}

// ─── TRACKING CORE ────────────────────────────────────────────────────────────

model TrackingEvent {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  eventType TrackingEventType
  status    TrackingStatus

  title       String
  description String?

  source    TrackingSource
  actorType TrackingActorType
  actorId   String?

  visibility TrackingVisibility

  locationName String?
  city         String?
  region       String?
  country      String?
  lat          Decimal? @db.Decimal(10, 8)
  lng          Decimal? @db.Decimal(11, 8)

  metadata Json?

  idempotencyKey String?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  proofOfDelivery ProofOfDelivery?

  @@unique([tenantId, shipmentId, idempotencyKey])
  @@index([tenantId, shipmentId])
  @@index([tenantId, trackingNumber])
  @@index([tenantId, status])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("tracking_events")
}

model TrackingBreadcrumb {
  id          BigInt   @default(autoincrement())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId  String   @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  seq         BigInt
  eventType   String   @map("event_type")
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  accuracyM   Int?     @map("accuracy_m")
  status      String?
  source      String
  sourceRef   String?  @map("source_ref")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz()
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([tenantId, shipmentId, seq])
  @@index([tenantId, shipmentId, occurredAt(sort: Desc)], map: "tracking_breadcrumbs_lookup")
  @@index([tenantId, occurredAt(sort: Desc)], map: "tracking_breadcrumbs_tenant_recent")
  @@map("tracking_breadcrumbs")
}

model TrackingSnapshot {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  currentStatus     TrackingStatus
  operationalStatus TrackingStatus
  customerStatus    String

  currentTitle   String
  currentMessage String?

  lastEventId String?
  lastEventAt DateTime?

  originName      String?
  destinationName String?

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  hasException     Boolean @default(false)
  exceptionCode    String?
  exceptionMessage String?

  assignedDriverId  String?
  assignedVehicleId String?

  podAvailable Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, currentStatus])
  @@index([tenantId, trackingNumber])
  @@map("tracking_snapshots")
}

model TrackingShare {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  publicToken String?            @unique
  accessMode  TrackingAccessMode @default(TRACKING_NUMBER_ONLY)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, shipmentId])
  @@map("tracking_shares")
}

model ProofOfDelivery {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingEventId String?        @unique
  trackingEvent   TrackingEvent? @relation(fields: [trackingEventId], references: [id])

  method PodMethod

  recipientName String?
  signatureUrl  String?
  photoUrls     String[]
  otpVerified   Boolean  @default(false)

  capturedByUserId    String?
  capturedByActorType String?

  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, shipmentId])
  @@map("proof_of_delivery")
}
