// Paste the complete schema below, replacing whatever is currently in schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  PROCESSING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
  EXCEPTION
}

enum TrackingStatus {
  CREATED
  BOOKED
  LABEL_GENERATED
  ASSIGNED
  PICKUP_SCHEDULED
  PICKED_UP
  AT_ORIGIN_HUB
  DEPARTED_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  FAILED_DELIVERY
  EXCEPTION
  CUSTOMS_HOLD
  CUSTOMS_RELEASED
  RETURN_STARTED
  RETURNED
  CANCELLED
}

enum TrackingEventType {
  SHIPMENT_CREATED
  SHIPMENT_BOOKED
  LABEL_GENERATED
  DRIVER_ASSIGNED
  PICKUP_SCHEDULED
  PICKED_UP
  ARRIVED_AT_HUB
  DEPARTED_HUB
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  FAILED_DELIVERY
  EXCEPTION_RAISED
  EXCEPTION_RESOLVED
  CUSTOMS_HOLD
  CUSTOMS_RELEASED
  RETURN_STARTED
  RETURNED
  CANCELLED
  POD_UPLOADED
  LOCATION_UPDATED
  ETA_UPDATED
  STATUS_OVERRIDE
  CUSTOMER_NOTIFICATION_SENT
  WEBHOOK_DISPATCHED
  WEBHOOK_FAILED
  OFFLINE_SYNC
}

enum TrackingSource {
  TENANT_PORTAL
  SUPERADMIN
  FAUWARD_GO
  CUSTOMER_PORTAL
  CARRIER_WEBHOOK
  API
  SYSTEM_AUTOMATION
  AI_AGENT
  QUEUE_WORKER
  MIGRATION
}

enum TrackingVisibility {
  PLATFORM_ONLY
  TENANT_INTERNAL
  CUSTOMER_VISIBLE
  FIELD_VISIBLE
}

enum TrackingActorType {
  TENANT_USER
  PLATFORM_USER
  CUSTOMER
  FIELD_USER
  DRIVER
  SYSTEM
  AI_AGENT
  CARRIER
}

enum PodMethod {
  SIGNATURE
  PHOTO
  OTP
  NAME
}

enum TrackingAccessMode {
  TRACKING_NUMBER_ONLY
  TRACKING_NUMBER_AND_POSTCODE
  SIGNED_LINK
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_MANAGER
  TENANT_FINANCE
  TENANT_STAFF
  TENANT_DRIVER
  CUSTOMER_ADMIN
  CUSTOMER_USER
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_OPERATIONS
  PLATFORM_FINANCE
  PLATFORM_READONLY
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum TenantStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  CANCELLED
  DEMO
}

enum TenantPlan {
  STARTER
  PRO
  ENTERPRISE
  TRIALING
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  PARTIALLY_PAID
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum LeadStage {
  PROSPECT
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum DocumentType {
  DELIVERY_NOTE
  INVOICE
  QUOTE
  CARGO_MANIFEST
  POD_RECEIPT
  CREDIT_NOTE
  AIR_WAYBILL
  BILL_OF_LADING
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  LABEL_ISSUED
  PICKED_UP
  IN_HUB
  RECEIVED
  REFUNDED
  RESOLVED
  REJECTED
}

enum ReturnPaymentStatus {
  NONE
  INVOICE_SENT
  PAID
  WAIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  DELIVERY_ISSUE
  PAYMENT_ISSUE
  DAMAGED_GOODS
  WRONG_ADDRESS
  TRACKING_ISSUE
  RETURN_REQUEST
  BILLING_QUERY
  OTHER
}

enum SurchargeType {
  PERCENT_OF_BASE
  PERCENT_OF_TOTAL
  FLAT_FEE
  PER_KG
}

enum SurchargeCondition {
  ALWAYS
  OVERSIZE
  OVERWEIGHT
  REMOTE_AREA
  RESIDENTIAL
  DANGEROUS_GOODS
  FUEL
  PEAK_SEASON
}

enum PricingRuleAction {
  ADD
  SUBTRACT
  MULTIPLY
  OVERRIDE_TOTAL
  OVERRIDE_PER_KG
  SET_MIN
  SET_MAX
}

enum PromoType {
  PERCENT_OFF
  FIXED_OFF
  FREE_INSURANCE
  FREE_EXPRESS
}

enum LabelFormat {
  PDF
  ZPL
  PNG
}

// ─── CORE PLATFORM ────────────────────────────────────────────────────────────

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  slug               String       @unique
  customDomain       String?      @unique
  domainVerified     Boolean      @default(false)
  customDomainStatus String       @default("NONE")
  customDomainVerificationToken String?
  customDomainAddedAt DateTime?   @db.Timestamptz()
  customDomainVerifiedAt DateTime? @db.Timestamptz()
  customDomainLastCheckAt DateTime? @db.Timestamptz()
  customDomainError  String?
  customDomainVercelId String?
  plan               TenantPlan   @default(TRIALING)
  status             TenantStatus @default(TRIALING)
  suspensionReason   String?
  suspendedAt        DateTime?
  kycStatus          String       @default("PENDING")
  taxExempt          Boolean      @default(false)
  taxExemptionCertificateUrl String?
  crmDealId          String?
  demoExpiresAt      DateTime?
  infrastructureType String       @default("SHARED")
  region             String       @default("uk_europe")
  logoUrl            String?
  primaryColor       String       @default("#0D1F3C")
  accentColor        String       @default("#D97706")
  brandName          String?
  isRtl              Boolean      @default(false)
  defaultCurrency    String       @default("GBP")
  defaultLanguage    String       @default("en")
  timezone           String       @default("Europe/London")
  showPoweredBy      Boolean      @default(true)
  smsEnabled         Boolean      @default(false)
  maxStaff           Int          @default(3)
  maxShipmentsPm     Int          @default(300)
  maxOrganisations   Int          @default(10)
  onboardingSteps    Json         @default("{}")
  onboardingCompletedAt DateTime?
  internalNotes      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users                         User[]
  shipments                     Shipment[]
  organisations                 Organisation[]
  leads                         Lead[]
  quotes                        Quote[]
  invoices                      Invoice[]
  payments                      Payment[]
  refunds                       Refund[]
  creditNotes                   CreditNote[]
  gatewayPayouts                GatewayPayout[]
  drivers                       Driver[]
  vehicles                      Vehicle[]
  routes                        Route[]
  serviceZones                  ServiceZone[]
  rateCards                     RateCard[]
  shipmentDocuments             ShipmentDocument[]
  apiKeys                       ApiKey[]
  webhookEndpoints              WebhookEndpoint[]
  webhookDeliveries             WebhookDelivery[]
  notificationLogs              NotificationLog[]
  usageRecords                  UsageRecord[]
  apiUsageRecords               ApiUsageRecord[]
  idempotencyKeys               IdempotencyKey[]
  auditLogs                     AuditLog[]
  passwordResetTokens           PasswordResetToken[]
  subscription                  Subscription?
  branches                      Branch[]
  accountingConnections         AccountingConnection[]
  settings                      TenantSettings?
  returnRequests                ReturnRequest[]
  supportTickets                SupportTicket[]
  ticketMessages                TicketMessage[]
  emailTemplateConfigs          EmailTemplateConfig[]
  surcharges                    Surcharge[]
  pricingRules                  PricingRule[]
  promoCodes                    PromoCode[]
  weightDiscountTiers           WeightDiscountTier[]
  inAppNotifications            InAppNotification[]
  planOverrides                 TenantPlanOverride[]
  platformImpersonationSessions PlatformImpersonationSession[]
  trackingEvents                TrackingEvent[]
  trackingBreadcrumbs           TrackingBreadcrumb[]
  trackingSnapshots             TrackingSnapshot[]
  trackingShares                TrackingShare[]
  proofsOfDelivery              ProofOfDelivery[]
  carrierAccounts               CarrierAccount[]
  carrierServiceLevels          CarrierServiceLevel[]
  rateQuotes                    RateQuote[]
  generatedLabels               GeneratedLabel[]
  shippingRules                 ShippingRule[]
  customsDeclarations           CustomsDeclaration[]
  tenantAiUsages                TenantAiUsage[]
  tenantAiLimit                 TenantAiLimit?
  aiAgentRuns                   AiAgentRun[]
  exceptionCases                ExceptionCase[]
  slaPolicies                   SlaPolicy[]
  slugHistory                   TenantSlugHistory[]
  widgetDomains                 TenantWidgetDomain[]

  @@index([customDomainStatus])
  @@map("tenants")
}

model TenantSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId  String   @map("tenant_id")
  oldSlug   String   @unique @map("old_slug")
  changedAt DateTime @default(now()) @map("changed_at")
  expiresAt DateTime @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@map("tenant_slug_history")
}

model TenantWidgetDomain {
  id         String    @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId   String    @map("tenant_id")
  host       String    @unique
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_widget_domains")
}

model PlatformUser {
  id                 String             @id @default(uuid())
  email              String             @unique
  name               String?
  passwordHash       String
  role               PlatformRole
  status             PlatformUserStatus @default(ACTIVE)
  mfaEnabled         Boolean            @default(false)
  mfaSecretEncrypted String?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  disabledAt         DateTime?

  sessions              PlatformSession[]
  staffUser             StaffUser?
  impersonationSessions PlatformImpersonationSession[]
  planOverrides         TenantPlanOverride[]

  @@index([status])
  @@map("platform_users")
}

model StaffUser {
  id             String      @id @default(uuid())
  platformUserId String?     @unique
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  email          String      @unique
  name           String
  ssoProvider    String      @default("totp")
  status         StaffStatus @default(ACTIVE)
  mfaEnabled     Boolean     @default(false)
  hardwareKeyId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lastLoginAt    DateTime?

  roleAssignments StaffRoleAssignment[]
  sessions        StaffSession[]

  @@index([status])
  @@map("staff_users")
}

model StaffRole {
  id          String   @id
  name        String
  description String
  permissions String[]
  isSystem    Boolean  @default(false)
  deprecated  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments StaffRoleAssignment[]

  @@map("staff_roles")
}

model StaffRoleAssignment {
  id        String    @id @default(uuid())
  staffId   String
  roleId    String
  grantedBy String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  StaffRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([staffId, roleId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("staff_role_assignments")
}

model StaffSession {
  id                String    @id @default(uuid())
  staffId           String
  platformSessionId String?   @unique
  ipAddress         String?
  userAgent         String?
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model PlatformSession {
  id               String       @id @default(uuid())
  platformUserId   String
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  mfaVerifiedAt    DateTime?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([platformUserId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

model PlatformImpersonationSession {
  id             String       @id @default(uuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  targetTenantId String
  targetTenant   Tenant       @relation(fields: [targetTenantId], references: [id])
  targetUserId   String?
  scopes         String[]     @default([])
  reason         String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([platformUserId])
  @@index([targetTenantId])
  @@index([expiresAt])
  @@map("platform_impersonation_sessions")
}

model TenantPlanOverride {
  id                      String       @id @default(uuid())
  tenantId                String
  tenant                  Tenant       @relation(fields: [tenantId], references: [id])
  plan                    TenantPlan
  reason                  String
  expiresAt               DateTime?
  createdByPlatformUserId String
  createdByPlatformUser   PlatformUser @relation(fields: [createdByPlatformUserId], references: [id])
  revokedAt               DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([tenantId, revokedAt, expiresAt])
  @@map("tenant_plan_overrides")
}

model TenantSettings {
  tenantId                     String   @id
  tenant                       Tenant   @relation(fields: [tenantId], references: [id])
  notificationEmail            String?
  smsEnabled                   Boolean  @default(false)
  paymentGateway               String   @default("STRIPE")
  paymentGatewayKey            String?
  customEmailDomain            String?
  webhookUrl                   String?
  webhookSecret                String?
  showPoweredBy                Boolean  @default(true)
  timezone                     String   @default("Europe/London")
  currency                     String   @default("GBP")
  emailFromName                String?
  emailReplyTo                 String?
  opsEmailRecipients           String[] @default([])
  serviceTierConfig            Json?
  insuranceConfig              Json?
  taxConfig                    Json?
  dimensionalDivisor           Int      @default(5000)
  weightTierConflictPolicy     String   @default("BEST_FOR_CUSTOMER")
  quoteValidityMinutes         Int      @default(30)
  showPriceBreakdownToCustomer Boolean  @default(true)
  autoInvoiceOnDelivery        Boolean  @default(false)
  slaDeliveryHours             Int      @default(72)
  roundingMode                 String   @default("ROUND_HALF_UP")
  roundingPrecision            Int      @default(2)
  updatedAt                    DateTime @updatedAt

  @@map("tenant_settings")
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  plan                 String
  billingCycle         String    @default("MONTHLY")
  status               String    @default("TRIALING")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelledAt          DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

model User {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  email          String
  phone          String?
  passwordHash   String?
  role           UserRole
  firstName      String?
  lastName       String?
  avatarUrl      String?
  isActive       Boolean       @default(true)
  mfaEnabled     Boolean       @default(false)
  mfaSecret      String?
  lastLogin      DateTime?
  invitedBy      String?
  ssoProvider    String?
  ssoSubject     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  refreshTokens       RefreshToken[]
  driver              Driver?
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  returnRequests      ReturnRequest[]      @relation("ReturnCustomer")
  handledReturns      ReturnRequest[]      @relation("ReturnHandledBy")
  supportTickets      SupportTicket[]      @relation("TicketCustomer")
  assignedTickets     SupportTicket[]      @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  inAppNotifications  InAppNotification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  region    String?
  address   Json?
  managerId String?
  createdAt DateTime @default(now())

  users     User[]
  shipments Shipment[]

  @@index([tenantId])
  @@map("branches")
}

// ─── ORGANISATIONS (B2B clients) ─────────────────────────────────────────────

model Organisation {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  companyNumber  String?
  taxNumber      String?
  billingEmail   String?
  billingAddress Json?
  paymentTerms   Int      @default(0)
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  billingOwnerId String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  users          User[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  invoices       Invoice[]
  quotes         Quote[]
  creditNotes    CreditNote[]

  @@index([tenantId])
  @@map("organisations")
}

// ─── SHIPMENTS ────────────────────────────────────────────────────────────────

model Shipment {
  id                  String         @id @default(uuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id])
  trackingNumber      String         @unique
  customerId          String?
  organisationId      String?
  organisation        Organisation?  @relation(fields: [organisationId], references: [id])
  assignedStaffId     String?
  assignedDriverId    String?
  driver              Driver?        @relation(fields: [assignedDriverId], references: [id])
  vehicleId           String?
  vehicle             Vehicle?       @relation(fields: [vehicleId], references: [id])
  routeId             String?
  status              ShipmentStatus @default(PENDING)
  originAddress       Json
  destinationAddress  Json
  serviceTier         String         @default("STANDARD")
  isSandbox           Boolean        @default(false)
  serviceZoneId       String?
  serviceZone         ServiceZone?   @relation(fields: [serviceZoneId], references: [id])
  estimatedDelivery   DateTime?
  actualDelivery      DateTime?
  price               Decimal?       @db.Decimal(12, 2)
  currency            String         @default("GBP")
  weightKg            Decimal?       @db.Decimal(8, 3)
  notes               String?
  specialInstructions String?
  insuranceValue      Decimal?       @db.Decimal(12, 2)
  promoCodeId         String?
  rateQuoteId         String?
  carrierAccountId    String?
  customsDeclarationId String?
  idempotencyKey      String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items            ShipmentItem[]
  events           ShipmentEvent[]
  documents        ShipmentDocument[]
  podAssets        PodAsset[]
  returnRequests   ReturnRequest[]
  returnPickupOf   ReturnRequest?   @relation("ReturnPickupShipment")
  supportTickets   SupportTicket[]
  promoCode        PromoCode?         @relation(fields: [promoCodeId], references: [id])
  invoice          Invoice?
  payment          Payment?
  trackingEvents   TrackingEvent[]
  trackingSnapshot TrackingSnapshot?
  trackingShares   TrackingShare[]
  proofsOfDelivery ProofOfDelivery[]
  routeStops       RouteStop[]
  rateQuote        RateQuote?         @relation(fields: [rateQuoteId], references: [id])
  carrierAccount   CarrierAccount?    @relation(fields: [carrierAccountId], references: [id])
  generatedLabels  GeneratedLabel[]
  customsDeclaration CustomsDeclaration?
  exceptionCases     ExceptionCase[]
  trackingBreadcrumbs TrackingBreadcrumb[]

  courierRefOrigin              String?
  courierRefDestination         String?
  customsClearanceConfirmed     Boolean  @default(false)

  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz()
  escalationFlag      Boolean  @default(false) @map("escalation_flag")
  escalationReason    String?  @map("escalation_reason")
  escalationFlaggedAt DateTime? @map("escalation_flagged_at") @db.Timestamptz()
  escalationResolvedAt DateTime? @map("escalation_resolved_at") @db.Timestamptz()
  escalationResolvedBy String?  @map("escalation_resolved_by")

  @@index([tenantId])
  @@index([tenantId, isSandbox])
  @@index([status])
  @@index([trackingNumber])
  @@index([customerId])
  @@index([promoCodeId])
  @@index([rateQuoteId])
  @@index([carrierAccountId])
  @@index([customsDeclarationId])
  @@map("shipments")
}

model ShipmentItem {
  id            String   @id @default(uuid())
  tenantId      String
  shipmentId    String
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  description   String?
  quantity      Int      @default(1)
  weightKg      Decimal? @db.Decimal(8, 3)
  lengthCm      Decimal? @db.Decimal(8, 2)
  widthCm       Decimal? @db.Decimal(8, 2)
  heightCm      Decimal? @db.Decimal(8, 2)
  declaredValue Decimal? @db.Decimal(12, 2)
  hsCode        String?
  isDangerous   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([shipmentId])
  @@index([tenantId])
  @@map("shipment_items")
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  tenantId   String
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   Json?
  notes      String?
  actorId    String?
  actorType  String?
  source     String   @default("MANUAL")
  timestamp  DateTime @default(now())

  @@index([shipmentId])
  @@index([tenantId])
  @@map("shipment_events")
}

model ShipmentDocument {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  shipmentId  String
  shipment    Shipment     @relation(fields: [shipmentId], references: [id])
  type        DocumentType
  templateId  String?
  fileUrl     String
  fileSize    Int?
  expiresAt   DateTime?
  generatedBy String?
  generatedAt DateTime     @default(now())

  @@index([shipmentId])
  @@index([tenantId])
  @@map("shipment_documents")
}

model PodAsset {
