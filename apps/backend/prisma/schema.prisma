  action                 String
  targetType             String?
  targetId               String?
  targetTenantId         String?
  targetUserId           String?
  impersonationSessionId String?
  sessionId              String?
  jitSessionId           String?
  before                 Json?
  after                  Json?
  reason                 String?
  metadata               Json
  ipAddress              String?
  userAgent              String?
  previousHash           String?
  hash                   String
  createdAt              DateTime @default(now())

  @@index([createdAt])
  @@index([targetTenantId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([sessionId, createdAt])
  @@map("platform_audit_logs")
}

// ─── ENTERPRISE: SSO ─────────────────────────────────────────────────────────

model SsoProvider {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  providerType String
  entityId     String?
  ssoUrl       String?
  certificate  String?
  attributeMap Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("sso_providers")
}

// ─── TRACKING CORE ────────────────────────────────────────────────────────────

model TrackingEvent {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  eventType TrackingEventType
  status    TrackingStatus

  title       String
  description String?

  source    TrackingSource
  actorType TrackingActorType
  actorId   String?

  visibility TrackingVisibility

  locationName String?
  city         String?
  region       String?
  country      String?
  lat          Decimal? @db.Decimal(10, 8)
  lng          Decimal? @db.Decimal(11, 8)

  metadata Json?

  idempotencyKey String?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  proofOfDelivery ProofOfDelivery?

  @@unique([tenantId, shipmentId, idempotencyKey])
  @@index([tenantId, shipmentId])
  @@index([tenantId, trackingNumber])
  @@index([tenantId, status])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("tracking_events")
}

model TrackingSnapshot {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  currentStatus     TrackingStatus
  operationalStatus TrackingStatus
  customerStatus    String

  currentTitle   String
  currentMessage String?

  lastEventId String?
  lastEventAt DateTime?

  originName      String?
  destinationName String?

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  hasException     Boolean @default(false)
  exceptionCode    String?
  exceptionMessage String?

  assignedDriverId  String?
  assignedVehicleId String?

  podAvailable Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, currentStatus])
  @@index([tenantId, trackingNumber])
  @@map("tracking_snapshots")
}

model TrackingShare {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingNumber String

  publicToken String?            @unique
  accessMode  TrackingAccessMode @default(TRACKING_NUMBER_ONLY)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, shipmentId])
  @@map("tracking_shares")
}

model ProofOfDelivery {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  trackingEventId String?        @unique
  trackingEvent   TrackingEvent? @relation(fields: [trackingEventId], references: [id])

  method PodMethod

  recipientName String?
  signatureUrl  String?
  photoUrls     String[]
  otpVerified   Boolean  @default(false)

  capturedByUserId    String?
  capturedByActorType String?

  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, shipmentId])
  @@map("proof_of_delivery")
}
